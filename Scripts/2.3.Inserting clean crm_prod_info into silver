
Insert Into Silver.crm_prod_info(
	prd_id ,
	cat_id ,
	prd_key ,
	prd_name ,
	prd_cost ,
	prd_line ,
	prd_start_date ,
	prd_end_date 
)

select 
	prd_id,
	REPLACE(SUBSTRING(prd_key,1,5),'-','_') as cat_id,
	SUBSTRING(prd_key,7,len(prd_key)) as prd_key,
	prd_name,
	isnull(prd_cost, 0) as prd_cost,
	case upper(trim(prod_line))
		when 'M' then 'mountain'
		when 'R' then 'road'
		when 'S' then 'other sales'
		when 'T' then 'touring'
		else 'n/a'
	end as prd_line,
	CAST(prd_start_date as date) as prd_start_date,
	CAST(LEAD(prd_end_date) over (partition by prd_key order by prd_start_date)-1 as date) as prd_end_date
from Bronze.crm_prod_info
